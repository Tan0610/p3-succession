# Copy to .env if you want to override defaults. Never put private keys in a tracked file.
# Bee API of the shared node (Swarm Desktop exposes it here):
BEE_URL=http://localhost:1633

# Keys are read from .secrets/keys/<name>.key (git-ignored). To use an environment
# variable instead, set LSC_KEY_<NAME> in your shell or in .env, e.g. LSC_KEY_STEWARD_PADMA.
# Leave them out of this file.
