{
  "name": "ladakh-spiti-catalogue-succession",
  "version": "1.0.0",
  "private": true,
  "description": "A shared manuscript catalogue for seven Himalayan monastery libraries, on Swarm, that survives its steward stopping.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "cli": "tsx cli/succession.ts",
    "ceremony": "tsx scripts/ceremony.ts",
    "verify:handoff": "tsx scripts/verify-handoff.ts",
    "audit:secrets": "tsx cli/succession.ts audit secrets",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:web && npm run ceremony -- --rehearse && npm run audit:secrets"
  },
  "dependencies": {
    "@ethersphere/bee-js": "13.1.0",
    "commander": "15.0.0",
    "ethers": "6.17.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
